Options -Indexes
RewriteEngine On
RewriteBase /

# Explicit clean URL routes for IPTI static frontend on Hostinger (LiteSpeed/Apache)
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^learner/?$ learner.html [L]
RewriteRule ^verify/?$ verify.html [L]
RewriteRule ^verify-certificate/?$ verify.html [L]
RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
RewriteRule ^terms-and-conditions/?$ terms-and-conditions.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Block direct access to sensitive config or backend files if ever uploaded
<FilesMatch "^(\.env|server\.js|package\.json|package-lock\.json|test-suite\.js)$">
  Require all denied
</FilesMatch>
